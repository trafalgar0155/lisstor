<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:lisstor.ViewModels"
             x:Class="lisstor.StoryPage"
             x:DataType="viewModels:StoryViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            Style="{StaticResource TopAppBar}">
            <Grid ColumnDefinitions="48,*" ColumnSpacing="8">
                <Button
                    Text="←"
                    Style="{StaticResource IconButton}"
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="Go back" />
                <Label
                    Grid.Column="1"
                    Text="Now reading"
                    Style="{StaticResource AppBarTitle}"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <WebView Grid.Row="1" Source="{Binding ReaderSource}" />

        <Grid
            Grid.Row="1"
            IsVisible="{Binding IsBusy}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True" WidthRequest="40" HeightRequest="40" />
                <Label Text="Loading story…" Style="{StaticResource SupportingText}" />
            </VerticalStackLayout>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="32"
            IsVisible="{Binding HasError}"
            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                <Label Text="Story unavailable" Style="{StaticResource SectionTitle}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource SupportingText}" HorizontalTextAlignment="Center" MaxLines="5" />
                <Button Text="Try again" Command="{Binding RetryCommand}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
